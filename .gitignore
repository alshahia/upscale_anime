# Data and Checkpoints (large files)
# ============================================================
data/
# The unqualified rule above also swallows the source package - re-include it
# (a fresh clone / CI checkout / git-archive build needs these tracked files).
!src/anime_sr/data/
!src/anime_sr/data/**
# ...but byte-code caches stay ignored everywhere.
src/anime_sr/data/**/__pycache__/
src/anime_sr/data/**/*.py[cod]
checkpoints/
pretrained/
runs/
logs/
output/
results/

