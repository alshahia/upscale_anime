# ============================================================
# Anime Super-Resolution Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# API Configuration
DSH_API_KEY=your_api_key_here

# Model and Output Paths
DSH_MODEL_PATH=./checkpoints
DSH_OUTPUT_PATH=./output

# Logging
DSH_LOG_LEVEL=INFO

# GPU Configuration
DSH_CUDA_VISIBLE_DEVICES=0

# Security
DSH_ALLOW_PICKLE_CHECKPOINT=false

# API Limits
DSH_MAX_FILE_SIZE_MB=50
DSH_RATE_LIMIT_PER_MIN=60
